{
  "id": "./",
  "name": "Pokédex Explorer",
  "short_name": "Pokédex",
  "description": "Explore Pokémon, compare stats and discover complete evolutions.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#050b17",
  "theme_color": "#e3350d",
  "orientation": "any",
  "lang": "en",
  "categories": ["education", "entertainment"],
  "icons": [
    {
      "src": "./icons/pokedex-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/pokedex-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/pokedex.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
