{
  "name": "pokedex-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm test && npm run lint && npm run format:check && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "update:pokemon-names": "node scripts/generate-pokemon-names.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
